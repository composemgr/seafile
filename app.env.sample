# Seafile - File sync and sharing platform
# Copy to app.env and customize before starting

# Timezone
TZ=America/New_York

# Hostname / Domain
BASE_HOST_NAME=${HOSTNAME}
BASE_DOMAIN_NAME=example.com

# Database credentials
DB_CREATE_DATABASE_NAME=seafile
DB_USER_NAME=seafile
DB_USER_PASS=changeme_db_password
DB_ADMIN_PASS=changeme_admin_password

# Admin account
APP_ADMIN_USER=admin@example.com
APP_ADMIN_PASS=changeme_admin_password
